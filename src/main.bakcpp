#define USE_DMA

#include <TFT_eSPI.h>
#include <SPI.h>
#include <math.h>

TFT_eSPI tft = TFT_eSPI();
TFT_eSprite horizonSprite = TFT_eSprite(&tft);

// Display dimensions
#define WIDTH 320
#define HEIGHT 240

// PFD parameters
float pitch = 0;       // degrees
float roll = 0;        // degrees
float airspeed = 120;  // knots
float altitude = 4500; // feet
float heading = 180;   // degrees
float vspeed = 0;      // feet per minute

// Colors
#define BACKGROUND_COLOR TFT_BLACK
#define HORIZON_COLOR TFT_BLUE
#define SKY_COLOR TFT_CYAN
#define GROUND_COLOR TFT_DARKGREEN
#define WHITE_COLOR TFT_WHITE
#define YELLOW_COLOR TFT_YELLOW
#define RED_COLOR TFT_RED

// Function declarations
void drawPFD();
void drawArtificialHorizon(float pitch, float roll);
void drawRollIndicator(float roll);
void drawAirspeedIndicator(float speed);
void drawAltitudeIndicator(float altitude, float vspeed);
void drawVerticalSpeedIndicator(float vspeed, int x, int y);
void drawHeadingIndicator(float heading);
void drawCenterReticle();
void rotateAndDrawSprite(float angle);

void setup()
{
  Serial.begin(115200);
  tft.init();
  tft.setRotation(1);
  tft.fillScreen(BACKGROUND_COLOR);

  // Create sprite for artificial horizon
  horizonSprite.createSprite(140, 140);
}

void loop()
{
  // Simulate changing flight parameters
  pitch = 5.0 * sin(millis() / 5000.0);
  roll = 20.0 * sin(millis() / 7000.0);
  airspeed = 120 + 20 * sin(millis() / 8000.0);
  altitude = 4500 + 500 * sin(millis() / 9000.0);
  heading = fmod(180 + 30 * sin(millis() / 6000.0), 360);
  vspeed = 500 * sin(millis() / 4000.0);

  drawPFD();
  delay(25); // Refresh rate ~20Hz
}

void drawPFD()
{
  tft.fillScreen(BACKGROUND_COLOR);

  // Draw the artificial horizon
  drawArtificialHorizon(pitch, roll);

  // Draw the airspeed indicator
  drawAirspeedIndicator(airspeed);

  // Draw the altitude indicator
  drawAltitudeIndicator(altitude, vspeed);

  // Draw the heading indicator
  drawHeadingIndicator(heading);

  // Draw the center reticle
  drawCenterReticle();
}

void drawArtificialHorizon(float pitch, float roll) {
  int centerX = WIDTH / 2;
  int centerY = HEIGHT / 2;
  int spriteWidth = 240;
  int spriteHeight = 240;
  
  // Clear and prepare sprite
  horizonSprite.fillSprite(SKY_COLOR);
  
  // Calculate horizon position based on pitch
  int horizonOffset = pitch * 3;
  int horizonLineY = spriteHeight / 2 + horizonOffset;
  
  // Draw ground area
  horizonSprite.fillRect(0, horizonLineY, 
                       spriteWidth, 
                       spriteHeight - horizonLineY, 
                       GROUND_COLOR);
  
  // Draw horizon line
  horizonSprite.drawFastHLine(0, horizonLineY, spriteWidth, WHITE_COLOR);
  
  // Draw pitch scale
  for (int i = -6; i <= 6; i++) {
    if (i == 0) continue;
    int yPos = spriteHeight / 2 + (i * 20) - horizonOffset;
    
    if (yPos >= 0 && yPos < spriteHeight) {
      horizonSprite.drawFastHLine(spriteWidth/2 - 30, yPos, 60, WHITE_COLOR);
      
      if (i % 2 == 0) {
        int degrees = abs(i * 5);
        horizonSprite.setTextColor(WHITE_COLOR, (i > 0) ? GROUND_COLOR : SKY_COLOR);
        horizonSprite.setTextSize(1);
        horizonSprite.setCursor(spriteWidth/2 - 40, yPos - 4);
        horizonSprite.print(degrees);
        horizonSprite.setCursor(spriteWidth/2 + 32, yPos - 4);
        horizonSprite.print(degrees);
      }
    }
  }
  
  // Set pivot point to sprite center
  horizonSprite.setPivot(spriteWidth/2, spriteHeight/2);
  
  // Create a temporary sprite for the screen
  TFT_eSprite screenSprite(&tft);
  screenSprite.createSprite(WIDTH, HEIGHT);
  screenSprite.fillSprite(BACKGROUND_COLOR);
  
  // Push rotated horizon to screen sprite at correct position
  horizonSprite.pushRotated(&screenSprite, roll, TFT_BLACK);
  
  // Push to display
  screenSprite.pushSprite(0, 0);
  screenSprite.deleteSprite();
  
  // Draw fixed roll indicators
  drawRollIndicator(roll);
}

void rotateAndDrawSprite(float angle)
{
  horizonSprite.pushRotated(angle, TFT_BLACK);
}

void drawRollIndicator(float roll)
{
  int centerX = WIDTH / 2;
  int centerY = HEIGHT / 2;
  int radius = 60;

  tft.drawCircle(centerX, centerY, radius, WHITE_COLOR);

  for (int angle = -60; angle <= 60; angle += 10)
  {
    if (angle == 0)
      continue;
    float rad = radians(angle);
    int x1 = centerX + radius * sin(rad);
    int y1 = centerY - radius * cos(rad);

    int markLength = (abs(angle) % 30 == 0) ? 12 : 6;
    int x2 = centerX + (radius - markLength) * sin(rad);
    int y2 = centerY - (radius - markLength) * cos(rad);

    tft.drawLine(x1, y1, x2, y2, WHITE_COLOR);

    if (abs(angle) % 30 == 0)
    {
      tft.setTextColor(WHITE_COLOR, BACKGROUND_COLOR);
      tft.setTextSize(1);
      x2 = centerX + (radius - 20) * sin(rad);
      y2 = centerY - (radius - 20) * cos(rad);
      tft.setCursor(x2 - 6, y2 - 4);
      tft.print(abs(angle));
    }
  }

  tft.fillTriangle(centerX - 5, centerY - radius - 10,
                   centerX, centerY - radius,
                   centerX + 5, centerY - radius - 10, RED_COLOR);
}

void drawAirspeedIndicator(float speed)
{
  int x = 30;
  int width = 40;
  int height = 140;
  int centerY = HEIGHT / 2;

  tft.fillRect(x, centerY - height / 2, width, height, BACKGROUND_COLOR);
  tft.drawRect(x, centerY - height / 2, width, height, WHITE_COLOR);

  float minSpeed = fmaxf(0.0f, speed - 60.0f);
  float maxSpeed = speed + 60.0f;

  for (int s = floor(minSpeed / 20) * 20; s <= maxSpeed; s += 20)
  {
    if (s < 0)
      continue;

    float pos = centerY - ((s - speed) * 2);

    if (pos >= centerY - height / 2 && pos <= centerY + height / 2)
    {
      tft.drawFastHLine(x + 10, pos, 20, WHITE_COLOR);

      tft.setTextColor(WHITE_COLOR, BACKGROUND_COLOR);
      tft.setTextSize(1);
      tft.setCursor(x + 5, pos - 6);
      tft.print(s);

      if (s % 20 == 0)
      {
        for (int i = 1; i <= 3; i += 2)
        {
          float subPos = pos + (i * 10);
          if (subPos >= centerY - height / 2 && subPos <= centerY + height / 2)
          {
            tft.drawFastHLine(x + 15, subPos, 15, WHITE_COLOR);
          }
        }
      }
    }
  }

  tft.fillRect(x, centerY - 15, width, 30, RED_COLOR);
  tft.setTextColor(WHITE_COLOR, RED_COLOR);
  tft.setTextSize(2);
  tft.setCursor(x + 5, centerY - 8);
  tft.print(int(speed));
}

void drawAltitudeIndicator(float altitude, float vspeed)
{
  int x = WIDTH - 70;
  int width = 40;
  int height = 140;
  int centerY = HEIGHT / 2;

  tft.fillRect(x, centerY - height / 2, width, height, BACKGROUND_COLOR);
  tft.drawRect(x, centerY - height / 2, width, height, WHITE_COLOR);

  float minAlt = max(0.0f, altitude - 500.0f);
  float maxAlt = altitude + 500.0f;

  for (int a = floor(minAlt / 100) * 100; a <= maxAlt; a += 100)
  {
    if (a < 0)
      continue;

    float pos = centerY - ((a - altitude) * 0.4);

    if (pos >= centerY - height / 2 && pos <= centerY + height / 2)
    {
      tft.drawFastHLine(x, pos, 20, WHITE_COLOR);

      tft.setTextColor(WHITE_COLOR, BACKGROUND_COLOR);
      tft.setTextSize(1);
      tft.setCursor(x + 22, pos - 6);
      tft.print(a / 100);

      if (a % 100 == 0)
      {
        for (int i = 1; i <= 4; i++)
        {
          float subPos = pos + (i * 20);
          if (subPos >= centerY - height / 2 && subPos <= centerY + height / 2)
          {
            tft.drawFastHLine(x + 5, subPos, 15, WHITE_COLOR);
          }
        }
      }
    }
  }

  tft.fillRect(x, centerY - 15, width, 30, RED_COLOR);
  tft.setTextColor(WHITE_COLOR, RED_COLOR);
  tft.setTextSize(2);
  tft.setCursor(x + 5, centerY - 8);
  tft.print(int(altitude / 100));

  drawVerticalSpeedIndicator(vspeed, x + width + 5, centerY);
}

void drawVerticalSpeedIndicator(float vspeed, int x, int centerY)
{
  int width = 15;
  int height = 80;

  tft.fillRect(x, centerY - height / 2, width, height, BACKGROUND_COLOR);
  tft.drawRect(x, centerY - height / 2, width, height, WHITE_COLOR);

  int needlePos = centerY - constrain(vspeed / 100, -3, 3) * (height / 6);

  tft.fillTriangle(x, needlePos - 5,
                   x + width, needlePos,
                   x, needlePos + 5, RED_COLOR);

  for (int i = -2; i <= 2; i++)
  {
    if (i == 0)
      continue;
    int y = centerY - i * (height / 6);
    tft.drawFastHLine(x + 3, y, 5, WHITE_COLOR);
    tft.setTextColor(WHITE_COLOR, BACKGROUND_COLOR);
    tft.setTextSize(1);
    tft.setCursor(x + 10, y - 4);
    tft.print(abs(i * 200));
  }
}

void drawHeadingIndicator(float heading)
{
  int centerX = WIDTH / 2;
  int topY = 20;
  int width = 180;
  int height = 20;

  tft.fillRect(centerX - width / 2, topY, width, height, BACKGROUND_COLOR);
  tft.drawRect(centerX - width / 2, topY, width, height, WHITE_COLOR);

  float minHeading = heading - 60;
  float maxHeading = heading + 60;

  for (int h = floor(minHeading / 10) * 10; h <= maxHeading; h += 10)
  {
    int normH = (h + 360) % 360;
    float pos = centerX + (h - heading) * 1.5;

    if (pos >= centerX - width / 2 && pos <= centerX + width / 2)
    {
      tft.drawFastVLine(pos, topY + 5, 10, WHITE_COLOR);

      if (normH % 30 == 0)
      {
        tft.setTextColor(WHITE_COLOR, BACKGROUND_COLOR);
        tft.setTextSize(1);
        tft.setCursor(pos - 6, topY + 15);
        tft.print(normH / 10);
      }
    }
  }

  tft.fillRect(centerX - 20, topY, 40, height, RED_COLOR);
  tft.setTextColor(WHITE_COLOR, RED_COLOR);
  tft.setTextSize(2);
  tft.setCursor(centerX - 15, topY + 2);
  tft.print(int(heading));
}

void drawCenterReticle()
{
  int centerX = WIDTH / 2;
  int centerY = HEIGHT / 2;

  tft.fillTriangle(centerX - 10, centerY,
                   centerX, centerY - 10,
                   centerX + 10, centerY, YELLOW_COLOR);
  tft.fillTriangle(centerX - 10, centerY,
                   centerX, centerY + 10,
                   centerX + 10, centerY, YELLOW_COLOR);
}